  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category         String
  name             String
  description      String?
  quantity         String?
  make             String?
  sort_order       Int?             @default(0)
  is_active        Boolean?         @default(true)
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?        @default(now()) @db.Timestamptz(6)
  solar_categories solar_categories @relation(fields: [category], references: [name], map: "fk_solar_product_components_category")

  @@index([category], map: "idx_solar_product_components_category")
  @@schema("public")
}

model solar_products {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category           String           @db.VarChar(50)
  system_size_kw     Decimal          @db.Decimal
  price              Decimal          @db.Decimal
  phase              String?          @default("1Ph") @db.VarChar(20)
  specifications     Json?            @default("{}")
  is_active          Boolean?         @default(true)
  created_at         DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?        @default(now()) @db.Timestamptz(6)
  name               String?          @db.VarChar(255)
  description        String?
  image_url          String?
  is_published       Boolean?         @default(true)
  brand              String?          @db.VarChar(100)
  sort_order         Int?             @default(0)
  price_includes_gst Boolean?         @default(true)
  gst_rate           Decimal?         @default(8.9) @db.Decimal
  solar_categories   solar_categories @relation(fields: [category], references: [name], map: "fk_solar_products_category")

  @@index([system_size_kw], map: "idx_products_size")
  @@schema("public")
}

model solar_quote_requests {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String?
  phone                    String?
  email                    String?
  entity_type              String?
  solution_classification  String?
  estimated_area_sqft      Decimal?  @db.Decimal
  monthly_bill             Decimal?  @db.Decimal
  power_demand_kw          Decimal?  @db.Decimal
  project_location         String?
  referral_name            String?
  referral_phone           String?
  product_name             String?
  product_category         String?
  source                   String?
  customer_type            String?
  referral_source          String?
  created_at               DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  mounting_type            String?
  company_name             String?
  additional_details       Json?
  estimated_system_size_kw Decimal?  @db.Decimal
  latitude                 Decimal?  @db.Decimal
  longitude                Decimal?  @db.Decimal
  brand                    String?

  @@schema("public")
}

model solar_subsidies {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @unique(map: "solar_subsidies_name_unique")
  scheme_type      String
  state            String?
  calculation_type String
  amount_per_kw    Decimal?  @default(0) @db.Decimal
  flat_amount      Decimal?  @default(0) @db.Decimal
  max_cap          Decimal?  @default(0) @db.Decimal
  description      String?
  is_active        Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model system_types {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String       @unique
  description   String?
  default_terms String[]
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  quotations    quotations[]

  @@schema("public")
}

model tata_config {
  config_key   String @id
  config_value String

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tata_grid_tie_systems {
  sl_no             Int      @id @default(autoincrement())
  system_size       Decimal  @db.Decimal(5, 2)
  no_of_modules     Int
  inverter_capacity Decimal? @db.Decimal(5, 2)
  phase             String
  total_price       Decimal  @db.Decimal(10, 2)
  price_per_kwp     Decimal? @default(dbgenerated("(total_price / system_size)")) @db.Decimal(10, 2)
  acdb_kit          String?  @default("1 nos")
  dcdb_kit          String?  @default("1 nos")
  ac_cable          String?  @default("Polycab/KEI 10 mtr")
  dc_cable          String?  @default("Polycab/KEI 40 mtr")
  module_structure  String?  @default("GI 3'X6'")
  earthing_rod      String?  @default("3 nos")
  earthing_chemical String?  @default("3 nos")
  earthing_wire     String?  @default("Al 10mm 90 mtr")
  lighting_arrestor String?  @default("1pc")

  @@schema("public")
}

